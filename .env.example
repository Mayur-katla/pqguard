# API
PORT=4100
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://mongo:27017/prguard

# GitHub ingestion
GITHUB_TOKEN=
PRGUARD_MAX_PRS=6

# Optional AI providers. The app works without these by using deterministic heuristics.
PRGUARD_AI_ENABLED=true
PRGUARD_AI_TIMEOUT_MS=12000
PRGUARD_AI_SCAN_LIMIT=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=roberta-base-openai-detector
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Frontend
VITE_API_BASE_URL=http://localhost:4100/api
